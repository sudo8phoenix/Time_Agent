ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://progress:progress@127.0.0.1:5432/progress
# Inside Docker, use a reachable host/service endpoint, e.g. http://host.docker.internal:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
REPORT_MODEL_TIMEOUT_SECONDS=360
AGENT_EXECUTION_MODE=graph
AGENT_HIERARCHY_ENABLED=false
ORCHESTRATOR_MODEL_ASSISTED=false
# Optional: only for an authenticated reverse proxy. Tailscale Serve does not need it.
OLLAMA_API_KEY=
SECRET_KEY=replace-with-a-random-value-at-least-16-characters
# Production requires a random SECRET_KEY of at least 32 characters.
# Registration defaults to disabled in production and enabled in development/test.
# Enabling it grants new accounts reviewer access to their own workspace.
# REGISTRATION_ENABLED=false
FRONTEND_DIST=frontend/dist
UPLOAD_DIR=uploads

# Switch report analysis and conversation to Groq.
LLM_PROVIDER=ollama
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_MODEL=openai/gpt-oss-20b

# OpenRouter requires an explicitly selected model ID; there is no implicit default.
# OPENROUTER_MODEL=
OPENROUTER_API_KEY=

# Model-assisted report planner accepts only these OpenRouter free model IDs:
# nvidia/nemotron-3-ultra-550b-a55b:free
# nvidia/nemotron-3.5-super-vl:free
# nvidia/nemotron-3-super-120b-a12b:free
# Configure ORCHESTRATOR_PROVIDER=openrouter and ORCHESTRATOR_MODEL=<one exact ID> to enable it.

# Optional trusted role assignments. Defaults retain LLM_PROVIDER and its existing model.
# Each role provider/model can be set independently. Groq key slots are 0 (GROQ_API_KEY), 1, or 2.
# ORCHESTRATOR_PROVIDER=
# ORCHESTRATOR_MODEL=
# ORCHESTRATOR_KEY_SLOT=0
# EXTRACTION_PROVIDER=
# EXTRACTION_MODEL=
# EXTRACTION_KEY_SLOT=0
# SELECTION_PROVIDER=
# SELECTION_MODEL=
# SELECTION_KEY_SLOT=0

# Opt-in only after reviewed database policy activation and a complete worker restart.
GROQ_ACCOUNT_SCOPES_ENABLED=false

# API/worker Unix socket for the isolated Docker parser service.
# PARSER_SOCKET_PATH=/run/site-parser/parser.sock
